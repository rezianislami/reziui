            0
          ],
          "children": [
            {
              "type": "text",
              "id": "u4cALv",
              "name": "Name",
              "fill": "$foreground",
              "content": "Card spotlight — hover",
              "fontFamily": "$font-sans",
              "fontSize": 14,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "YoLEq",
              "name": "Spec",
              "fill": "$muted-foreground",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A 1px light on the card's edge follows the pointer (220px radial gradient, foreground at 45%). Mouse/trackpad only; fades in over 200ms on hover.",
              "lineHeight": 1.6,
              "fontFamily": "$font-mono",
              "fontSize": 11.5,
              "fontWeight": "normal"
            }
          ]
        }
